
# ─── Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ────────────────────────────────────────────────────────────

# App
APP_NAME=Nestjs_Clean_Template
NODE_ENV=localhost
ZONE=local
PORT=31000
HEALTH_CHECK_PORT=3001

# Debug
R4NDR4NDS33D_DEBUG_ENCRYPTION_SERVICE=1

# Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nestjs_db
DATABASE_USER=natthaphong
DATABASE_PASSWORD=postgres_secret1

# Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=      # Set in non-local envs
REDIS_TTL=300

# Limits
MEM_LIMIT=4Gi
RETRYKAFKACOUNTMAX=4


# Kafka — used by HealthCheck (KafkaJS-style) and as fallback in YAML config loader
BROKERS=localhost:9092
# API_KEY=             # Kafka SASL username (for non-local envs)
# API_SECRET=          # Kafka SASL password (for non-local envs)
KAFKA_CLIENT_ID=nestjs-clean-template
TOPIC_NOTIFICATION_INCOMING=notification.incoming


BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=your_secret_password


# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d
