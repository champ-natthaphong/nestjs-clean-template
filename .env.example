
# ─── Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ────────────────────────────────────────────────────────────

# App
ZONE=local
PORT=3080
HEALTH_CHECK_PORT=3001

# Debug
R4NDR4NDS33D_DEBUG_ENCRYPTION_SERVICE=1

# Database
DATABASE_TIMEOUT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs_template?schema=public"
DATABASE_NAME=your_database_name
DATABASE_AUTH_TYPE=password
# DATABASE_CERT=      # Path to cert file (for non-local envs)

# Kafka — used by HealthCheck (KafkaJS-style) and as fallback in YAML config loader
BROKERS=localhost:9092
# API_KEY=             # Kafka SASL username (for non-local envs)
# API_SECRET=          # Kafka SASL password (for non-local envs)

# Kafka — Confluent KafkaJS transport (rat-common-lib >= 0.5.0).
# CustomServerConfluentKafkaJS reads KAFKA_CONSUMER_* / KAFKA_PRODUCER_* env vars
# (KAFKA_CONSUMER_GROUP_ID → group.id, prefix stripped, _ → .).
# Required for non-local envs:
# KAFKA_CONSUMER_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092
# KAFKA_CONSUMER_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_CONSUMER_SASL_MECHANISM=PLAIN
# KAFKA_CONSUMER_SASL_USERNAME=
# KAFKA_CONSUMER_SASL_PASSWORD=
# KAFKA_PRODUCER_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092
# KAFKA_PRODUCER_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_PRODUCER_SASL_MECHANISM=PLAIN
# KAFKA_PRODUCER_SASL_USERNAME=
# KAFKA_PRODUCER_SASL_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=      # Set in non-local envs
REDIS_TTL=300

# Limits
MEM_LIMIT=4Gi
RETRYKAFKACOUNTMAX=4
