{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^@nestjs/typeorm$": "<rootDir>/mocks/nestjs-typeorm.ts",
    "^@nestjs/passport$": "<rootDir>/mocks/nestjs-passport.ts",
    "^@nestjs/jwt$": "<rootDir>/mocks/generic-stub.ts",
    "^@nestjs/swagger$": "<rootDir>/mocks/generic-stub.ts",
    "^uuid$": "<rootDir>/mocks/uuid.ts",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
